  "boxes": [
   {
    "box": {
     "id": "obj-1",
     "patching_rect": [
      40,
      40,
      780,
      520
     ],
     "maxclass": "codebox",
     "numinlets": 1,
     "numoutlets": 3,
     "outlettype": [
      "",
