<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Mac Catalyst only (CODE_SIGN_ENTITLEMENTS[sdk=macosx*]); the iPhone build
	     signs with no entitlements file and never reads this one. The Mac App
	     Store refuses a build without the sandbox, and the sandbox starts from
	     nothing: each line below is something the app already does on the phone. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- The web view's network process is part of the sandbox; without this a
	     sandboxed WKWebView can come up blank on a custom-scheme page. The app
	     itself talks to no server (see the export-compliance note in Info.plist). -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Ableton Link listens for the other apps of a session on the local network
	     (multicast UDP); a sandboxed app may not receive without this. -->
	<key>com.apple.security.network.server</key>
	<true/>
	<!-- Recording into the sampler and the capture inputs. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- Photographing a chord sheet to import (ModOcr). -->
	<key>com.apple.security.device.camera</key>
	<true/>
	<!-- Bluetooth MIDI (ModMidi). USB MIDI needs nothing. -->
	<key>com.apple.security.device.bluetooth</key>
	<true/>
	<!-- Opening a chord sheet or a sample from a file picker, and the share
	     sheet's Save to Files. Bounces are written inside the app's own
	     container (Documents/Bounces), which the sandbox always allows. -->
	<!-- Bounces and stems are written to ~/Downloads/mõdRïff (ModEngine.dirURL). -->
	<key>com.apple.security.files.downloads.read-write</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
</dict>
</plist>
