<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- iPhone and iPad. iCloud sync (ModCloud.swift) talks to the person's own private
	     CloudKit database. The Swift is compiled in by MODRIFF_CLOUDKIT, and a build
	     with that flag but without these two keys ends the app the first time the page
	     asks CloudKit for the container, so the flag and this file move together.
	     The Mac build has its own copy of the same keys in AppMac.entitlements. -->
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.Handel.modRiff</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
</dict>
</plist>
