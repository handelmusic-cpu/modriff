<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<!-- Bluetooth LE MIDI. CABTMIDICentralViewController (ModMidi.openBluetooth)
	     scans for BLE peripherals to show the pairing sheet, and iOS terminates
	     an app that starts a scan with no usage string — not a prompt, not a
	     refusal, an immediate crash. Nothing is scanned until the button in
	     Settings › MIDI is pressed. -->
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>mõdRïff uses Bluetooth to find and connect Bluetooth MIDI keyboards and controllers.</string>
	<!-- Sampler › Record. getUserMedia from the web view needs a usage string
	     or iOS ends the app the moment the sampler asks for the microphone.
	     Nothing is captured until the user starts a recording. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>mõdRïff uses the microphone only when you record a sample. The audio stays on your device.</string>
	<!-- Chord sheet import › Camera. A photo of a songbook page is read on the
	     device (text recognition, no network). The web view's capture input
	     needs a usage string or iOS ends the app the moment the camera opens.
	     Nothing is captured until the person chooses Camera in the import. -->
	<key>NSCameraUsageDescription</key>
	<string>mõdRïff uses the camera only when you photograph a chord sheet to import. The picture stays on your device.</string>
	<!-- The app does no encryption of its own (everything runs on the device and
	     it talks to no server), so export-compliance questions are answered once
	     here instead of in App Store Connect on every build. -->
	<!-- Bounces are written to Documents/Bounces as they are made and this is what
	     lets the Files app show that folder (On My iPhone > mõdRïff). The share
	     sheet that opens after a bounce is a second way to the same files, so a
	     share that fails or is cancelled loses nothing. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
        <string>mõdRïff</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
    <false/>
    <key>UISceneConfigurations</key>
    <dict>
      <key>UIWindowSceneSessionRoleApplication</key>
      <array>
        <dict>
            <key>UISceneConfigurationName</key>
            <string>Default Configuration</string>
            <key>UISceneDelegateClassName</key>
            <string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
            <key>UISceneStoryboardFile</key>
            <string>Main</string>
        </dict>
      </array>
    </dict>
	</dict>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<!-- Keep playing when the app is left: the engine is an AVAudioEngine on a
	     .playback session, which iOS only keeps alive in the background with
	     this mode. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
</dict>
</plist>
